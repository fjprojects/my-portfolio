# Docker Compose reads this file. The local Python process reads environment
# variables directly; it does not automatically load .env.
# Generate fresh values: python -c "import secrets; print(secrets.token_urlsafe(40))"
# Use URL-safe characters for the database password in this sample connection URL.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-value
SECRET_KEY=replace-with-another-long-random-value
